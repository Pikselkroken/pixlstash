include README.md
include LICENSE
recursive-include frontend package.json package-lock.json
prune frontend/node_modules
recursive-include pixlstash/frontend/dist *
include pixlstash/alembic.ini
recursive-include pixlstash/migrations *
recursive-include pixlstash/image_plugins/built-in *.py
include pixlstash/training/trainer_hook/sitecustomize.py
recursive-include pixlstash/data/anchors *.npy
recursive-include pixlstash/data/comfyui-workflows/built-in *.json
recursive-include pixlstash/data/scalar-assets *
recursive-include pixlstash/data/tag_groups *.json *.txt
include pixlstash/data/workflow_templates.json
include pixlstash/data/workflow_templates_index.json
recursive-include pixlstash/data/workflow_templates *.json
recursive-include pixlstash/data/comfyui-pack *
