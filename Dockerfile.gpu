# ── Stage 1: Build the Vue frontend ──────────────────────────────────────────
FROM node:24-slim AS frontend-builder

WORKDIR /build/frontend
COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
# Copy pyproject.toml so Vite can read the version at build time
COPY pyproject.toml /build/pyproject.toml
RUN npm run build


# ── Stage 2: Build Python venv with all dependencies ─────────────────────────
# Use the CUDA image so torch can link against the right CUDA version at build
# time, but we only copy the finished venv into the final stage.
FROM nvidia/cuda:13.0.3-cudnn-runtime-ubuntu24.04 AS python-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    python3-pip \
    python3.12-dev \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libheif-dev \
    libde265-dev \
    libx265-dev \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip wheel setuptools

# PyTorch for CUDA 13.0, the same generation as the base image and the
# desktop's NVIDIA overlay (TORCH_INDEX.cu130 in electron/src/config.ts), at
# the torch CI tests (requirements.txt) and the torchvision built for it.
# Installed before the rest so nothing pulls in a CPU-only torch.
RUN pip install --no-cache-dir \
    torch==2.13.0 \
    torchvision==0.28.0 \
    --index-url https://download.pytorch.org/whl/cu130

# Everything else: pyproject.toml's dependencies, less torch, torchvision and
# onnxruntime.
COPY pyproject.toml /tmp/pyproject.toml
RUN python -c "import tomllib; print('\\n'.join(tomllib.load(open('/tmp/pyproject.toml', 'rb'))['project']['dependencies']))" \
        | grep -v -E '^(torch|torchvision|onnxruntime)([~=<>! ]|$)' > /tmp/deps.txt \
    && pip install --no-cache-dir -r /tmp/deps.txt \
    && rm /tmp/pyproject.toml /tmp/deps.txt

# onnxruntime-gpu for CUDA inference, a CUDA 13 build like the base image (the
# desktop pins the same, ORT_GPU_PIN.cu130 in electron/src/config.ts). It goes
# in last, after removing plain onnxruntime: insightface depends on that, and
# both install the same `onnxruntime` module, so whichever lands second wins.
# The check reads the CUDA provider library's links: listing the provider
# among the available ones only says it was compiled in, and a CUDA-generation
# mismatch passes that and runs face detection on the CPU. Every library must
# resolve except libcuda.so.1, the driver, which the NVIDIA runtime mounts only
# when the container starts.
RUN pip uninstall -y onnxruntime
RUN pip install --no-cache-dir onnxruntime-gpu==1.32.0 \
    && python -c "import onnxruntime as o; assert 'CUDAExecutionProvider' in o.get_available_providers()" \
    && missing="$(ldd /opt/venv/lib/python3.12/site-packages/onnxruntime/capi/libonnxruntime_providers_cuda.so | grep 'not found' | grep -v 'libcuda\.so\.1 ' || true)" \
    && if [ -n "$missing" ]; then echo "ONNX Runtime's CUDA provider cannot load: $missing"; exit 1; fi



# ── Stage 3: Lean runtime image ───────────────────────────────────────────────
# Start from the same CUDA base but only copy the finished venv — no build
# tools, no dev headers, no pip cache, no compiler output.
FROM nvidia/cuda:13.0.3-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

# Only runtime system libraries: no build-essential, no python3.12-dev.
# The upgrade first: the CUDA base tag is not rebuilt, so its Ubuntu packages
# are as old as the tag (#2755) unless the image takes the security updates.
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libheif1 \
    libde265-0 \
    libx265-199 \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1

# Create non-root user BEFORE copying the venv so we can use --chown at copy
# time — avoids a separate chown layer that would double the venv's disk cost.
RUN groupadd -f -g 10001 pixlstash \
    && useradd -r -u 10001 -g 10001 -m -d /home/pixlstash pixlstash

# Copy the fully-built venv with correct ownership in a single layer
COPY --from=python-builder --chown=pixlstash:pixlstash /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app
RUN chown pixlstash:pixlstash /app

USER pixlstash

# ── Copy application source ───────────────────────────────────────────────────
COPY --chown=pixlstash:pixlstash pyproject.toml setup.py MANIFEST.in alembic.ini ./
COPY --chown=pixlstash:pixlstash pixlstash/ pixlstash/
# The ComfyUI-PixlStash nodes, read in place by the editable install below
# (comfyui_pack_service checks /app/integrations first). Needs the submodule
# checked out; the smoke test below fails the build when it is empty.
COPY --chown=pixlstash:pixlstash integrations/ComfyUI-PixlStash integrations/ComfyUI-PixlStash

# Install the pixlstash package itself (no deps — already installed above)
RUN pip install --no-cache-dir --no-deps -e .

# Smoke test: import the server exactly as the entrypoint will. The pip list
# above is hand-maintained and the install is --no-deps, so a dependency added
# to pyproject.toml but not to that list produces a green build and an image
# that dies on start-up (send2trash did, in v1.10.0). This fails the build
# instead, before anything is tagged or pushed.
# It also asserts the image carries the ComfyUI nodes: without the submodule
# the COPY above copies an empty folder and the app offers no node install.
RUN python -c "import pixlstash.server; from pixlstash.services.comfyui_pack_service import bundled_pack; assert bundled_pack(), 'ComfyUI-PixlStash nodes missing: run git submodule update --init'"

# Copy the pre-built frontend into the package's expected location
COPY --chown=pixlstash:pixlstash --from=frontend-builder /build/pixlstash/frontend/dist pixlstash/frontend/dist/

# ── Entrypoint ────────────────────────────────────────────────────────────────
USER root
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
USER pixlstash

# Ensure $HOME always points at the mounted volume regardless of which UID
# --user maps to at runtime (the UID may match a different user in /etc/passwd).
ENV HOME=/home/pixlstash
ENV PIXLSTASH_DOCKER_VARIANT=gpu

# Volume for persistent data — mount /home/pixlstash to persist config, images,
# downloaded models, and the database across container restarts.
VOLUME ["/home/pixlstash"]

EXPOSE 9537

ENTRYPOINT ["docker-entrypoint.sh"]
