# ── Dockerfile.demo ───────────────────────────────────────────────────────────
# Builds a self-contained read-only demo image with vault.db and pictures baked
# in.  No persistent volume is used — the data is static.
#
# Prerequisites — create this layout alongside the repo before building:
#
#   demo-data/
#     server-config.json   # image_root must be "/home/pixlstash/images"
#     images/              # vault.db + all picture files go here
#
# Build and push:
#   docker build -f Dockerfile.demo -t registry.fly.io/pixlstash-demo:latest .
#   flyctl auth docker
#   docker push registry.fly.io/pixlstash-demo:latest
#   flyctl deploy --config fly.toml --image registry.fly.io/pixlstash-demo:latest
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Build the Vue frontend ──────────────────────────────────────────
FROM node:22-slim AS frontend-builder

WORKDIR /build/frontend
COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
# Copy pyproject.toml so Vite can read the version at build time
COPY pyproject.toml /build/pyproject.toml
RUN npm run build


# ── Stage 2: Runtime image (CPU-only) ────────────────────────────────────────
FROM python:3.12-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libheif-dev \
    libde265-dev \
    libx265-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip wheel setuptools

RUN pip install --no-cache-dir \
    torch \
    torchvision \
    --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir onnxruntime

RUN pip install --no-cache-dir \
    open_clip_torch \
    fastapi \
    "uvicorn[standard]" \
    numpy \
    pillow \
    opencv-python-headless \
    scipy \
    platformdirs \
    tomli \
    colorlog \
    httpx \
    python-multipart \
    requests \
    transformers \
    insightface \
    rapidfuzz \
    tqdm \
    sentence_transformers \
    pillow-heif \
    sqlmodel \
    alembic \
    "python-jose[cryptography]" \
    passlib \
    "bcrypt<4.0.0" \
    nvidia-ml-py \
    psutil \
    piexif \
    watchdog \
    python-dotenv \
    click \
    accelerate \
    bitsandbytes \
    zstandard \
    send2trash

RUN apt-get purge -y --auto-remove build-essential && rm -rf /var/lib/apt/lists/*

RUN groupadd -f -g 10001 pixlstash \
    && useradd -r -u 10001 -g 10001 -m -d /home/pixlstash pixlstash \
    && chown -R pixlstash:pixlstash /app

COPY --chown=pixlstash:pixlstash pyproject.toml setup.py MANIFEST.in alembic.ini ./
COPY --chown=pixlstash:pixlstash pixlstash/ pixlstash/

RUN pip install --no-cache-dir --no-deps -e .

# Smoke test: import the server exactly as the entrypoint will. The pip list
# above is hand-maintained and the install is --no-deps, so a dependency added
# to pyproject.toml but not to that list produces a green build and an image
# that dies on start-up (send2trash did, in v1.10.0). This fails the build
# instead, before anything is tagged or pushed.
RUN python -c "import pixlstash.server"

COPY --chown=pixlstash:pixlstash --from=frontend-builder /build/pixlstash/frontend/dist pixlstash/frontend/dist/

# ── Bake in demo data ─────────────────────────────────────────────────────────
# demo-data/server-config.json  →  /home/pixlstash/.config/pixlstash/server-config.json
# demo-data/hub.db              →  /home/pixlstash/.config/pixlstash/hub.db
# demo-data/images/             →  /home/pixlstash/images/  (contains vault.db + pictures)
#
# The hub is not optional. Since the portable-identity split the owner and every
# token live in hub.db, not in vault.db, so an image that bakes in only the vault
# starts with an empty hub: no owner, no tokens, and the public ?token= link is
# refused. The container log says so in one line — "Registering an existing vault
# at /home/pixlstash/images without importing identity".
#
# image_root is rewritten to the in-container path at build time so you don't
# have to edit server-config.json manually before each build.
RUN mkdir -p /home/pixlstash/.config/pixlstash /home/pixlstash/images

COPY --chown=pixlstash:pixlstash demo-data/server-config.json \
    /home/pixlstash/.config/pixlstash/server-config.json

# Rewrite image_root, host, port and security settings to canonical in-container values.
# disable_password_auth is always forced to true so nobody can log in via password
# regardless of how demo-data/server-config.json was configured locally.
# disable_background_workers is forced to true so no models are loaded and no
# background tasks run — the demo database is fully processed and read-only.
RUN python3 -c "import json; path='/home/pixlstash/.config/pixlstash/server-config.json'; cfg=json.load(open(path)); cfg['image_root']='/home/pixlstash/images'; cfg['host']='0.0.0.0'; cfg['port']=8080; cfg['disable_password_auth']=True; cfg['disable_background_workers']=True; cfg['default_device']='cpu'; open(path,'w').write(json.dumps(cfg, indent=2))"

COPY --chown=pixlstash:pixlstash demo-data/hub.db \
    /home/pixlstash/.config/pixlstash/hub.db

# Re-point the baked hub at the in-container paths, keeping library.uuid intact
# because every token is stamped with it — rewrite the path, not the identity.
# The model shelf is dropped: its rows name folders on the machine that built the
# image, which do not exist here and must not be published on a public demo. The
# server re-registers its own managed store on start.
RUN python3 -c "import sqlite3; p='/home/pixlstash/.config/pixlstash/hub.db'; r='/home/pixlstash/images'; c=sqlite3.connect(p); [c.execute(q) for q in ('DELETE FROM model_file', 'DELETE FROM model_capability', 'DELETE FROM model', 'DELETE FROM adapter_stack', 'DELETE FROM model_folder')]; [c.execute(q, (r,)) for q in ('UPDATE library SET path = ?', 'UPDATE library_uuid_issued SET first_path = ?', 'UPDATE identity_migration_operation SET source_path = ?')]; c.commit(); assert c.execute('SELECT count(*) FROM usertoken').fetchone()[0], 'demo-data/hub.db holds no token - the public ?token= link would be refused'; assert c.execute('SELECT count(*) FROM library WHERE is_active = 1 AND path = ?', (r,)).fetchone()[0] == 1, 'demo-data/hub.db has no single active library'; c.close()"

COPY --chown=pixlstash:pixlstash demo-data/images/ \
    /home/pixlstash/images/

# Ensure the directories themselves (not just their contents) are owned by
# pixlstash so the startup writable-check can create temp files there.
RUN chown pixlstash:pixlstash /home/pixlstash/images /home/pixlstash/.config/pixlstash \
    && chmod 700 /home/pixlstash/.config/pixlstash \
    && chmod 600 /home/pixlstash/.config/pixlstash/hub.db

# ── Entrypoint ────────────────────────────────────────────────────────────────
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

USER pixlstash

ENV HOME=/home/pixlstash
ENV PIXLSTASH_PORT=8080

EXPOSE 8080

ENTRYPOINT ["docker-entrypoint.sh"]
