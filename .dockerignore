# Version control
.git
.gitignore

# Python caches and build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.venv/
venv/
*.egg

# Frontend source (built in Stage 1; only dist is copied into runtime)
frontend/node_modules/
frontend/dist/

# Tests and dev tooling
tests/
scripts/
.ruff_cache/
.pytest_cache/
pytest.ini
CONTRIBUTING.md
TODO.txt
tasksystem.md
docs/
website/
tmp/
# ...except the one page the holiday-mode image (holiday/Dockerfile) serves.
!website/demo-holiday.html

# Docker files themselves (avoid recursive context issues)
Dockerfile
docker-compose.yml
.dockerignore

# Downloaded models (large; mount or download at runtime)
downloaded_models/

# Installer artefacts
installer/

# The ComfyUI-PixlStash pack's own tests, media and git plumbing (~7 MB); the
# image carries only what ComfyUI loads, as the wheel does
# (comfyui_pack_service.PACK_LEFT_OUT).
integrations/ComfyUI-PixlStash/.git*
integrations/ComfyUI-PixlStash/.ruff_cache/
integrations/ComfyUI-PixlStash/.pytest_cache/
integrations/ComfyUI-PixlStash/tests/
integrations/ComfyUI-PixlStash/examples/
integrations/ComfyUI-PixlStash/screenshots/
integrations/ComfyUI-PixlStash/**/__pycache__/

# A wheel build's staged copy of the pack is an older build's: keep it out, so
# the image reads the submodule and the build's pack check cannot pass on it.
pixlstash/data/comfyui-pack/
